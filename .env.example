# Copy to .env (ignored by git) and fill in real values locally.

# MySQL/MariaDB connection. The database name is required.
DATABASE_URL="mysql://<user>:<password>@localhost:3306/ibmv_lms"

# Auth.js signing secret. Generate with: npx auth secret
AUTH_SECRET="<generate-a-long-random-value>"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Used once by `npm run db:seed` to create the first Super Admin. Remove after seeding.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="<choose-a-strong-password>"

# Optional: lets seeded demo staff/learner accounts sign in (local development only).
SEED_DEMO_PASSWORD="<choose-a-local-password>"

# Separate empty database used only by integration tests (npm test). Tests skip when unset.
TEST_DATABASE_URL="mysql://<user>:<password>@localhost:3306/ibmv_lms_test"
